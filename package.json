{
  "name": "discoursio-webapp",
  "private": true,
  "version": "0.15.5",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vinxi dev",
    "dev:demo": "node scripts/dev-demo.mjs",
    "build": "vinxi build",
    "build:debug": "cross-env DEBUG_BUILD=true vinxi build",
    "build:netlify": "npm run codegen:all && vinxi build",
    "start": "cross-env NODE_ENV=production node scripts/server.mjs",
    "start:debug": "npm run build:debug && cross-env DEBUG_BUILD=true node scripts/server.mjs",
    "prestart": "npm run build",
    "lint": "biome lint .",
    "check": "npm run lint && npm run typecheck && npm test",
    "fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen",
    "codegen:inbox": "graphql-codegen --config codegen-inbox.ts",
    "codegen:all": "npm run codegen && npm run codegen:inbox",
    "codegen:check": "npm run codegen:all && git diff --exit-code -- src/graphql/generated",
    "e2e": "npm run e2e:clean && npm run e2e:test -- --project=chromium",
    "e2e:demo": "playwright test --config playwright.demo.config.ts",
    "e2e:hydration": "playwright test tests/e2e/hydration-debug.spec.ts",
    "e2e:ui": "playwright test --ui tests/e2e/",
    "e2e:test": "playwright test tests/e2e/",
    "e2e:smoke": "playwright test tests/e2e --grep @smoke",
    "e2e:auth": "playwright test tests/e2e --grep @auth --storage-state=playwright/.auth/user.json",
    "e2e:ui:smoke": "playwright test --ui tests/e2e --grep @smoke",
    "e2e:ui:auth": "playwright test --ui tests/e2e --grep @auth --storage-state=playwright/.auth/user.json",
    "e2e:debug": "cross-env DEBUG=pw:webserver,vinxi:* playwright test tests/e2e/ --debug",
    "dev:e2e": "cross-env PORT=3001 vinxi dev --port 3001",
    "e2e:report": "playwright show-report",
    "test:editor-auth": "playwright test tests/e2e/90-editor-auth-test.spec.ts --reporter=list",
    "test:editor-format": "playwright test tests/e2e/91-editor-formatting-test.spec.ts --reporter=list",
    "test:editor-upload": "playwright test tests/e2e/92-editor-upload-test.spec.ts --reporter=list",
    "test:editor-workflow": "playwright test tests/e2e/93-editor-full-workflow-test.spec.ts --reporter=list",
    "test:editor-all": "playwright test tests/e2e/9*-editor-*.spec.ts --reporter=list",
    "e2e:clean": "rimraf test-results/ playwright-report/",
    "e2e:ci": "cross-env CI=true npm run e2e:test",
    "e2e:install": "playwright install chromium",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit/static-files.test.mjs tests/unit/request-validation.test.mjs tests/unit/demo-api.test.mjs tests/unit/image-runtime.test.mjs",
    "build:ci": "cross-env SASS_FORCE_JS=true npm run build",
    "templates": "node ./templates/compile.cjs",
    "setup:https": "node scripts/setup-https.mjs",
    "clean": "rimraf .output .vinxi node_modules/.vinxi",
    "reset": "npm run clean && npm install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/client-preset": "^5.1.0",
    "@playwright/test": "^1.56.0",
    "@solid-primitives/cookies": "^0.0.3",
    "@solid-primitives/media": "^2.3.1",
    "@solid-primitives/pagination": "^0.4.1",
    "@solid-primitives/resource": "^0.4.2",
    "@solid-primitives/selection": "^0.1.3",
    "@solid-primitives/share": "^2.2.1",
    "@solid-primitives/storage": "^4.3.2",
    "@solid-primitives/upload": "^0.1.3",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.3",
    "@solidjs/start": "^1.3.2",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^24.7.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/throttle-debounce": "^5.0.2",
    "@urql/core": "^6.0.0",
    "clsx": "^2.1.1",
    "cross-env": "10.1.0",
    "diff-match-patch": "^1.0.5",
    "dotenv": "^17.2.1",
    "extended-eventsource": "^2.1.0",
    "fast-deep-equal": "^3.1.3",
    "graphql": "^16.11.0",
    "husky": "9.1.7",
    "i18next": "^25.5.3",
    "i18next-http-backend": "^3.0.2",
    "i18next-icu": "^2.4.0",
    "isomorphic-dompurify": "^2.28.0",
    "javascript-time-ago": "^2.5.11",
    "lightningcss": "^1.30.2",
    "rimraf": "6.0.1",
    "sass": "^1.93.2",
    "solid-js": "^1.9.15",
    "solid-popper": "^0.3.0",
    "swiper": "^12.2.0",
    "throttle-debounce": "^5.0.2",
    "tippy.js": "^6.3.7",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typograf": "^7.4.4",
    "vite": "6.4.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-solid": "^2.11.9",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27"
  },
  "dependencies": {
    "form-data": "^4.0.6",
    "mailgun.js": "^12.9.0",
    "sharp": "0.35.3",
    "solid-sonner": "0.2.8"
  },
  "overrides": {
    "esbuild": "0.25.10",
    "vite": "6.4.3"
  }
}
