{
  "name": "discoursio-webapp",
  "private": true,
  "version": "0.9.25",
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "start": "NODE_ENV=production node --no-deprecation .output/server/index.mjs",
    "start:debug": "NODE_ENV=production node --inspect-brk --enable-source-maps .output/server/index.mjs",
    "prestart": "npm run build",
    "codegen": "graphql-codegen",
    "e2e": "E2E=1 npm run e2e:tests",
    "e2e:tests": "npx playwright test --project=webkit",
    "e2e:tests:ci": "CI=true npx playwright test --project=webkit",
    "e2e:install": "npx playwright install webkit && npx playwright install-deps ",
    "fix": "npx @biomejs/biome check . --fix && stylelint **/*.{scss,css} --fix",
    "format": "npx @biomejs/biome format src/. --write",
    "postinstall": "patch-package && npm run codegen",
    "typecheck": "tsc --noEmit",
    "templates": "node ./templates/compile.cjs"
  },
  "devDependencies": {
    "@authorizerdev/authorizer-js": "^2.0.3",
    "@biomejs/biome": "^1.9.4",
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/typescript": "^4.1.5",
    "@graphql-codegen/typescript-operations": "^4.5.1",
    "@graphql-codegen/typescript-urql": "^4.0.0",
    "@playwright/test": "^1.51.0",
    "@solid-primitives/media": "^2.3.0",
    "@solid-primitives/pagination": "^0.4.0",
    "@solid-primitives/selection": "^0.1.1",
    "@solid-primitives/share": "^2.2.0",
    "@solid-primitives/storage": "^4.3.1",
    "@solid-primitives/upload": "^0.1.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.3",
    "@solidjs/start": "^1.1.1",
    "@types/cookie-signature": "^1.1.2",
    "@types/diff-match-patch": "1.0.36",
    "@types/node": "^22.13.1",
    "@types/sanitize-html": "2.13.0",
    "@types/throttle-debounce": "5.0.2",
    "@urql/core": "^5.1.0",
    "axe-playwright": "^2.0.3",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "cookie-signature": "^1.2.2",
    "cropperjs": "^1.6.2",
    "diff-match-patch": "1.0.5",
    "extended-eventsource": "^2.1.0",
    "fast-deep-equal": "^3.1.3",
    "graphql": "^16.10.0",
    "i18next": "^24.2.3",
    "i18next-http-backend": "^3.0.2",
    "i18next-icu": "^2.3.0",
    "intl-messageformat": "^10.7.15",
    "isomorphic-dompurify": "^2.23.0",
    "javascript-time-ago": "^2.5.11",
    "patch-package": "8.0.0",
    "sass": "1.85.1",
    "solid-js": "^1.9.3",
    "solid-popper": "^0.3.0",
    "stylelint": "^16.15.0",
    "stylelint-config-recommended": "^15.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-order": "^6.0.4",
    "stylelint-scss": "^6.10.0",
    "swiper": "^11.2.5",
    "throttle-debounce": "5.0.2",
    "tippy.js": "^6.3.7",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "typograf": "^7.4.1",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-sass-dts": "^1.3.30",
    "y-protocols": "1.0.6",
    "yjs": "13.6.24"
  },
  "dependencies": {
    "form-data": "^4.0.1",
    "idb": "^8.0.1",
    "mailgun.js": "^12.0.0"
  }
}
