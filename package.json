{
  "name": "discoursio-webapp",
  "private": true,
  "version": "0.12.1",
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "start": "NODE_ENV=production node --no-deprecation .output/server/index.mjs",
    "start:debug": "NODE_ENV=production node --inspect-brk --enable-source-maps .output/server/index.mjs",
    "prestart": "npm run build",
    "lint": "npx @biomejs/biome lint .",
    "check": "npx @biomejs/biome check .",
    "fix": "npx @biomejs/biome check . --fix",
    "format": "npx @biomejs/biome format . --write",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen",
    "test": "vitest run tests/unit/",
    "test:unit": "vitest run tests/unit/",
    "test:unit:ui": "vitest --ui tests/unit/",
    "test:unit:watch": "vitest watch tests/unit/",
    "e2e:ui": "playwright test --ui tests/e2e/",
    "e2e:report": "playwright show-report",
    "e2e:clean": "rm -rf test-results/ playwright-report/",
    "e2e:dev": "vinxi dev --port 3001",
    "e2e:test": "npx playwright test tests/e2e/ --project=hydration-debug",
    "e2e:hydration": "npx playwright test tests/e2e/hydration-debug.spec.ts --project=hydration-debug",
    "e2e": "npm run e2e:clean && npm run e2e:test",
    "e2e:ci": "CI=true npm run e2e:test",
    "e2e:tests": "npx playwright test tests/ --project=webkit",
    "e2e:tests:ci": "CI=true npx playwright test --project=webkit",
    "e2e:install": "npx playwright install webkit && npx playwright install-deps",
    "postinstall": "patch-package && npm run codegen",
    "templates": "node ./templates/compile.cjs",
    "clean": "rm -rf .output .vinxi node_modules/.vinxi",
    "reset": "npm run clean && npm install",
    "prepare": "[ \"$VERCEL\" != \"1\" ] && npm run e2e:install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "@graphql-codegen/add": "5.0.3",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/client-preset": "^4.8.3",
    "@graphql-codegen/introspection": "4.0.3",
    "@graphql-codegen/schema-ast": "4.1.0",
    "@graphql-codegen/typed-document-node": "5.1.2",
    "@graphql-codegen/typescript": "^4.1.0",
    "@graphql-codegen/typescript-document-nodes": "4.0.16",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-resolvers": "4.5.1",
    "@graphql-codegen/typescript-urql": "^4.0.1",
    "@playwright/test": "1.54.1",
    "@solid-primitives/media": "^2.3.1",
    "@solid-primitives/pagination": "^0.4.1",
    "@solid-primitives/resource": "^0.4.2",
    "@solid-primitives/selection": "^0.1.3",
    "@solid-primitives/share": "^2.2.1",
    "@solid-primitives/storage": "^4.3.2",
    "@solid-primitives/upload": "^0.1.3",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.3",
    "@solidjs/start": "^1.1.5",
    "@testing-library/jest-dom": "6.6.3",
    "@types/cookie-signature": "^1.1.2",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^24.0.12",
    "@types/sanitize-html": "^2.16.0",
    "@types/throttle-debounce": "^5.0.2",
    "@urql/core": "^5.1.1",
    "@vitest/ui": "^2.1.8",
    "axe-playwright": "^2.1.0",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "cookie-signature": "^1.2.2",
    "diff-match-patch": "^1.0.5",
    "dotenv": "^16.5.0",
    "extended-eventsource": "^2.1.0",
    "fast-deep-equal": "^3.1.3",
    "graphql": "^16.11.0",
    "happy-dom": "18.0.1",
    "i18next": "^25.2.1",
    "i18next-http-backend": "^3.0.2",
    "i18next-icu": "^2.3.0",
    "intl-messageformat": "^10.7.16",
    "isomorphic-dompurify": "^2.25.0",
    "javascript-time-ago": "^2.5.11",
    "jsdom": "26.1.0",
    "lightningcss": "^1.28.1",
    "patch-package": "8.0.0",
    "playwright": "^1.53.0",
    "sass": "^1.89.0",
    "solid-js": "^1.9.7",
    "solid-popper": "^0.3.0",
    "solid-testing-library": "^0.5.1",
    "solid-toast": "^0.5.0",
    "swiper": "^11.2.8",
    "throttle-debounce": "^5.0.2",
    "tippy.js": "^6.3.7",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "typograf": "^7.4.4",
    "vite": "latest",
    "vite-plugin-node-polyfills": "0.23.0",
    "vite-plugin-sass-dts": "^1.3.31",
    "vite-plugin-solid": "2.11.7",
    "vitest": "^2.1.8",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27"
  },
  "dependencies": {
    "@vercel/og": "^0.6.8",
    "form-data": "^4.0.3",
    "mailgun.js": "^12.0.3"
  },
  "overrides": {
    "esbuild": "latest",
    "vite": "latest"
  }
}
