# Public browser configuration. Leave blank to use the application defaults.
PUBLIC_BASE_URL=
PUBLIC_CORE_API=
PUBLIC_INBOX_API=
PUBLIC_REALTIME_EVENTS=
PUBLIC_CDN_URL=
PUBLIC_GA_IDENTITY=
PUBLIC_GLITCHTIP_DSN=

# Server-only mail integration. Never commit a value.
MAILGUN_API_KEY=

# Optional runtime settings.
PORT=3000
HOST=127.0.0.1
LOCAL_HTTPS=false
TOKEN_REFRESH_INTERVAL=30

# Optional GraphQL codegen overrides. Local schemas are used by default.
GRAPHQL_SCHEMA_URL=
INBOX_GRAPHQL_SCHEMA_URL=

# Optional integration E2E configuration. Never commit account credentials.
E2E_BASE_URL=
TEST_USERNAME=
TEST_PASSWORD=
