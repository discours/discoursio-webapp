{
  "headers": [
    {
      "source": "/:path*\\.(jpg|jpeg|gif|png|svg|webp|ico)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/:path*\\.(jpg|jpeg|gif|png|svg|webp|ico)",
      "has": [
        {
          "type": "query",
          "key": "retry"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|svg|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "images": {
    "sizes": [256, 384, 640, 750, 828, 1080, 1200, 1920],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "files.dscrs.site"
      },
      {
        "protocol": "https",
        "hostname": "images.discours.io"
      },
      {
        "protocol": "https",
        "hostname": "assets.discours.io"
      },
      {
        "protocol": "https",
        "hostname": "cdn.discours.io"
      }
    ],
    "minimumCacheTTL": 60,
    "formats": ["image/webp"],
    "dangerouslyAllowSVG": true,
    "contentSecurityPolicy": "default-src 'self'; script-src 'none'; sandbox;"
  },
  "crons": [
    {
      "path": "/api/purge-cache",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/files.dscrs.site/:path*",
      "destination": "https://files.dscrs.site/:path*"
    }
  ]
}
