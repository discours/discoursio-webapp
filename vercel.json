{
  "headers": [
    {
      "source": "/(.*)\\.(?:jpg|jpeg|gif|png|svg|webp|ico)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/files.dscrs.site/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ],
  "images": {
    "sizes": [256, 384, 640, 750, 828, 1080, 1200, 1920],
    "domains": ["files.dscrs.site", "images.discours.io", "assets.discours.io", "cdn.discours.io"],
    "minimumCacheTTL": 86400,
    "formats": ["image/webp"]
  }
}
